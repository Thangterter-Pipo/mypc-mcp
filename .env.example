# MyPC MCP Server — Configuration Template
# Copy this file to .env (or run scripts\install.ps1 to generate automatically)

# --- Security (Required) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MYPC_MCP_API_KEY=change-me-to-a-long-random-string

# Owner PIN required on /consent when authorizing OAuth clients (ChatGPT/Claude/Gemini).
# Leave empty to disable OAuth consent.
MYPC_MCP_CONSENT_PIN=change-me-pin

# Set to 1 only if you want ChatGPT OAuth callbacks auto-approved without entering PIN.
MYPC_MCP_AUTO_APPROVE_CHATGPT=0

# --- Network & Tailscale ---
# Bind to 127.0.0.1 — Tailscale Funnel / Serve proxies HTTPS directly to localhost.
MYPC_MCP_HOST=127.0.0.1
MYPC_MCP_PORT=3080

# Tailscale mode:
#   funnel -> Public HTTPS (required for ChatGPT Web, Claude Web, Gemini Web)
#   serve  -> Private Tailnet-only HTTPS (for your own devices on Tailscale)
#   none   -> Local only (127.0.0.1)
MYPC_MCP_TAILSCALE_MODE=funnel

# Your Tailscale HTTPS origin (auto-filled by scripts\tailscale_setup.ps1)
# Example: https://my-pc.tail12345.ts.net
MYPC_MCP_BASE_URL=https://your-machine.your-tailnet.ts.net

# --- Filesystem & Limits ---
# Default working root for relative paths (defaults to your Windows user home)
# MYPC_MCP_ROOT=C:\Users\YourName

# Optional comma-separated drive allowlist (leave empty to allow all accessible drives)
# Example: C:,D:,E:
MYPC_MCP_ALLOWED_DRIVES=

COMMAND_TIMEOUT_SECONDS=120
MAX_COMMAND_OUTPUT_MB=20
MAX_FILE_READ_MB=50
UVICORN_KEEP_ALIVE=20
AUDIT_LOG_ENABLED=true

# --- Optional OAuth extras ---
# Extra allowed OAuth redirect prefixes (comma-separated)
# MYPC_MCP_OAUTH_REDIRECT_PREFIXES=
# Allow http://localhost/ OAuth callbacks (1 = enabled, 0 = disabled)
# MYPC_MCP_ALLOW_LOCAL_OAUTH=0
